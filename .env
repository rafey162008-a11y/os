# ============================================
# Environment Configuration - DO NOT commit to git
# ============================================

# Flask
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-secret-key

# Database connection
# SQLite (default, file-based, no server required):
DATABASE_URL=sqlite:///online_shopping.db
# PostgreSQL alternative (uncomment and set to use Postgres instead):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/online_shopping_db

# Admin super user (used by seed.py)
ADMIN_EMAIL=admin@shop.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Super Admin

# Payment gateway / email credentials (optional placeholders)
PAYMENT_API_KEY=your-payment-api-key
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
